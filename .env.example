# --- Supabase ---
# HTTPS API URL only (NOT the postgresql:// connection string)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer publishable key (current Supabase docs). anon key kept for compatibility.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Postgres URL for migrations (db push). Never use NEXT_PUBLIC_ for this.
# DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Ingest (optional) ---
# Max POSTs per store_key per rolling minute (default 60).
# INGEST_RATE_LIMIT_PER_MINUTE=60

# --- Runrunit ---
RUNRUNIT_APP_KEY=
RUNRUNIT_USER_TOKEN=
RUNRUNIT_PROJECT_ID=
RUNRUNIT_TYPE_ID=
# Optional override (default: https://runrun.it/api/v1.0)
# RUNRUNIT_BASE_URL=

# --- Discord ---
DISCORD_WEBHOOK_URL=

# --- Sentry (apps/web only — not for store SDKs) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
